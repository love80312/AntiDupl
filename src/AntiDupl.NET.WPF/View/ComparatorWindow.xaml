
<Window x:Class="AntiDupl.NET.WPF.View.ComparatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:control="clr-namespace:AntiDupl.NET.WPF.Control"
        xmlns:convertor="clr-namespace:AntiDupl.NET.WPF.Convertor"
        xmlns:behavior="clr-namespace:AntiDupl.NET.WPF.Behavior"
        Title="{DynamicResource comparatorwindow_title}">

    <Window.Resources>
        <convertor:ListToBackgroundMultiValueConverter
            x:Key="listToBackgroundMultiValueConverter"/>

        <convertor:FileSizeConverter
            x:Key="fileSizeConverter"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Command="{Binding PreviousCommand}" Key="Left" />
        <KeyBinding Command="{Binding NextCommand}" Key="Right" />
    </Window.InputBindings>

    <i:Interaction.Behaviors>
        <behavior:WindowCloseOnEscBehavior />
    </i:Interaction.Behaviors>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button Visibility="Collapsed" IsCancel="True"></Button>

        <control:CgsImageViewer
            x:Name="cgsImageViewer"
            Grid.Row="0"
            CurrentImage="{Binding Image}">
        </control:CgsImageViewer>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Command="{Binding PreviousCommand}" Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <Image
                        Source="/AntiDupl.NET.WPF;component/Image/arrow-190-64-left.png"
                        MaxHeight="16" />

                    <Label Content="{DynamicResource comparatorWindow_Previous}" />
                </StackPanel>
            </Button>

            <Button
                Content="{DynamicResource comparatorWindow_DeleteOther}"
                Command="{Binding DeleteOtherCommand}"
                Grid.Column="1" />

            <Button Command="{Binding NextCommand}" Grid.Column="2">
                <StackPanel Orientation="Horizontal">
                    <Label Content="{DynamicResource comparatorWindow_Next}" />

                    <Image
                        Source="/AntiDupl.NET.WPF;component/Image/arrow-190-64-rigth.png"
                        MaxHeight="16" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal">

            <Button
                Content="{DynamicResource comparatorWindow_ExternalDiff}"
                Command="{Binding OpenExternalDiffCommand}"
                Margin="0,0,4,0"/>

            <TextBox
                Text="{Binding CurrentInfo.Resolution, Mode=OneWay}"
                IsReadOnly="True"
                ToolTip="{DynamicResource comparatorWindow_Resolution}">

                <TextBox.Background>
                    <MultiBinding
                        Converter="{StaticResource listToBackgroundMultiValueConverter}"
                        ConverterParameter="{x:Static convertor:MaxProperty.Resolution}">

                        <Binding Path="ImageInfos" Mode="OneWay" />
                        <Binding Path="CurrentInfo.Width" Mode="OneWay" />
                        <Binding Path="Configuration.GoodColor" Mode="OneWay" />
                        <Binding Path="Configuration.BadColor" Mode="OneWay" />
                        <Binding Path="CurrentInfo.Height" Mode="OneWay" />
                    </MultiBinding>
                </TextBox.Background>
            </TextBox>

            <TextBox
                Text="{Binding CurrentInfo.FileSize, Mode=OneWay, Converter={StaticResource fileSizeConverter}}"
                IsReadOnly="True"
                ToolTip="{DynamicResource comparatorWindow_FileSize}">

                <TextBox.Background>
                    <MultiBinding
                        Converter="{StaticResource listToBackgroundMultiValueConverter}"
                        ConverterParameter="{x:Static convertor:MaxProperty.FileSize}">

                        <Binding Path="ImageInfos" Mode="OneWay" />
                        <Binding Path="CurrentInfo.FileSize" Mode="OneWay" />
                        <Binding Path="Configuration.GoodColor" Mode="OneWay" />
                        <Binding Path="Configuration.BadColor" Mode="OneWay" />
                    </MultiBinding>
                </TextBox.Background>
            </TextBox>

            <Label Content="{DynamicResource comparatorWindow_Blockiness}" />

            <TextBox
                Text="{Binding CurrentInfo.Blockiness, Mode=OneWay, StringFormat=G3}"
                IsReadOnly="True"
                ToolTip="{DynamicResource comparatorWindow_Blockiness}">

                <TextBox.Background>
                    <MultiBinding
                        Converter="{StaticResource listToBackgroundMultiValueConverter}"
                        ConverterParameter="{x:Static convertor:MaxProperty.Blockiness}">

                        <Binding Path="ImageInfos" Mode="OneWay" />
                        <Binding Path="CurrentInfo.Blockiness" Mode="OneWay" />
                        <Binding Path="Configuration.GoodColor" Mode="OneWay" />
                        <Binding Path="Configuration.BadColor" Mode="OneWay" />
                    </MultiBinding>
                </TextBox.Background>
            </TextBox>

            <Label Content="{DynamicResource comparatorWindow_Blurring}" />

            <TextBox
                Text="{Binding CurrentInfo.Bluring, Mode=OneWay, StringFormat=G2}"
                IsReadOnly="True"
                ToolTip="{DynamicResource comparatorWindow_Blurring}">

                <TextBox.Background>
                    <MultiBinding
                        Converter="{StaticResource listToBackgroundMultiValueConverter}"
                        ConverterParameter="{x:Static convertor:MaxProperty.Bluring}">

                        <Binding Path="ImageInfos" Mode="OneWay" />
                        <Binding Path="CurrentInfo.Bluring" Mode="OneWay" />
                        <Binding Path="Configuration.GoodColor" Mode="OneWay" />
                        <Binding Path="Configuration.BadColor" Mode="OneWay" />
                    </MultiBinding>
                </TextBox.Background>
            </TextBox>

            <TextBox
                Text="{Binding CurrentInfo.UtilityIndex, Mode=OneWay, StringFormat=G3}"
                IsReadOnly="True"
                ToolTip="{DynamicResource comparatorWindow_UtilityIndex}">

                <TextBox.Background>
                    <MultiBinding
                        Converter="{StaticResource listToBackgroundMultiValueConverter}"
                        ConverterParameter="{x:Static convertor:MaxProperty.UtilityIndex}">

                        <Binding Path="ImageInfos" Mode="OneWay" />
                        <Binding Path="CurrentInfo.UtilityIndex" Mode="OneWay" />
                        <Binding Path="Configuration.GoodColor" Mode="OneWay" />
                        <Binding Path="Configuration.BadColor" Mode="OneWay" />
                    </MultiBinding>
                </TextBox.Background>
            </TextBox>

            <TextBox
                Text="{Binding CurrentInfo.Path, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                VerticalAlignment="Bottom" />

        </StackPanel>
    </Grid>
</Window>
