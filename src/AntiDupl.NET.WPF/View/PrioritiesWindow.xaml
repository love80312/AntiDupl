
<Window x:Class="AntiDupl.NET.WPF.View.PrioritiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:control="clr-namespace:AntiDupl.NET.WPF.Control"
        xmlns:convertor="clr-namespace:AntiDupl.NET.WPF.Convertor"
        Title="{DynamicResource prioritieswindow_title}"
        Height="300"
        Width="300">

    <Window.Resources>
        <convertor:InverseBooleanConverter
            x:Key="inverseBooleanConverter"/>
    </Window.Resources>

    <StackPanel Orientation="Vertical">

        <Label Content="{DynamicResource prioritiesWindow_CriterionWeigth}" />

        <DataGrid
            ItemsSource="{Binding Path=Criterions}"
            AutoGenerateColumns="False"
            IsEnabled="{Binding FillingMode, Converter={StaticResource inverseBooleanConverter}}">

            <DataGrid.Columns>

                <DataGridCheckBoxColumn
                    Header="{DynamicResource prioritiesWindow_IsUse}"
                    Binding="{Binding IsUse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <DataGridTextColumn
                    Header="{DynamicResource prioritiesWindow_Name}"
                    Binding="{Binding Name}"/>

                <DataGridTextColumn
                    Header="{DynamicResource prioritiesWindow_Weight}"
                    Binding="{Binding Weight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            </DataGrid.Columns>
        </DataGrid>

        <Button
            Content="{DynamicResource prioritiesWindow_button_SetDefault}"
            Command="{Binding SetDefaulCommand}"/>

        <Button
            Content="{DynamicResource prioritiesWindow_pairedComparison}"
            Command="{Binding StartFillingCommand}"/>

        <Label Content="{DynamicResource prioritiesWindow_enterCriteriaPriorities}"/>

        <Label Content="{Binding HowMuchText}" />

        <control:NumericUpDown
            x:Name="nud"
            Change=".1"
            Margin="10"
            Height="40"
            DecimalPlaces="2"
            Minimum="0.1"
            Value="{Binding HowMuch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsEnabled="{Binding FillingMode}"/>

        <Button
            Content="{DynamicResource prioritiesWindow_button_OK}"
            Command="{Binding HowMuchAddedCommand}" />

        <DataGrid
            ItemsSource="{Binding DataView}"
            AutoGenerateColumns="True"
            IsEnabled="{Binding FillingMode}"/>

    </StackPanel>
</Window>
