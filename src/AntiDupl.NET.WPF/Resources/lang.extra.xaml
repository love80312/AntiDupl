    <v:String x:Key="configurationWindow_deepDinov2ModelNotFound">DINOv2 model file not found: {0}. Place it manually; automatic download is not available.</v:String>
    <v:String x:Key="configurationWindow_deepDinov2UrlMissing">DINOv2 download URL is not set (Configuration &gt; Deep).</v:String>
    <v:String x:Key="configurationWindow_deepDinov2ModelUpToDate">DINOv2 model is up to date: {0}</v:String>
    <v:String x:Key="configurationWindow_deepDinov2Downloading">Downloading DINOv2 model… {0}</v:String>
    <v:String x:Key="configurationWindow_deepDinov2Downloaded">DINOv2 model downloaded: {0}</v:String>
