    <v:String x:Key="configurableActionWindow_LabelAction">Action</v:String>
    <v:String x:Key="configurableActionWindow_LabelFilterConditions">Filter conditions</v:String>
    <v:String x:Key="configurableActionWindow_GroupDirectory">Directory</v:String>
